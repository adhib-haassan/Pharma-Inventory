# Copy this file to .env and fill in the values for your local setup.
# .env is ignored by Git; keep real credentials there.

# Optional override for the demo login password.
MEDINEXUS_LOGIN_PASSWORD=

# Groq chatbot. Get an API key from the Groq console.
GROQ_API_KEY=

# SMTP settings used to email forecast PDFs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Set true for implicit TLS (commonly port 465); otherwise the app uses STARTTLS.
SMTP_USE_SSL=false
